{
  "name": "deadline-puce-fantome",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "tsc --noEmit",
    "test:world": "esbuild scripts/world-audit.ts --bundle --format=esm --platform=node --external:@dimforge/rapier3d-compat --outfile=.vite/world-audit.mjs && node .vite/world-audit.mjs",
    "test:pursuit": "esbuild scripts/pursuit-audit.ts --bundle --format=esm --platform=node --external:@dimforge/rapier3d-compat --outfile=.vite/pursuit-audit.mjs && node .vite/pursuit-audit.mjs",
    "build": "npm run check && vite build",
    "build:portable": "npm run build && node scripts/portable.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "6.4.5"
  }
}
